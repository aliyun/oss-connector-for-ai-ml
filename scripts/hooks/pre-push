#!/bin/sh
# osstables-secret-hook
set -eu

repo_root=$(git rev-parse --show-toplevel)
remote_name=${1:-}

is_zero_oid() {
  [ -n "$1" ] || return 1
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_ref:-}" ] || continue
  if is_zero_oid "$local_oid"; then
    continue
  fi

  if is_zero_oid "$remote_oid"; then
    if [ -n "$remote_name" ]; then
      log_options="$local_oid --not --remotes=$remote_name"
    else
      log_options="$local_oid --not --remotes"
    fi
  else
    log_options="$remote_oid..$local_oid"
  fi

  printf '%s\n' "Scanning outgoing commits for $remote_ref"
  "$repo_root/scripts/check-secrets.sh" range "$log_options"
done
